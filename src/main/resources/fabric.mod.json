{
  "schemaVersion": 1,
  "id": "subtitlescreen",
  "version": "${version}",
  "name": "字幕方块",
  "description": "一个可以在大屏上显示字幕的方块模组（Minecraft 26.3）。初版由旧模型 v3.2 生成，现依据《经验.md》升级至 26.3。",
  "authors": [
    "SubTitleScreen Team"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.subtitlescreen.SubtitleScreenMod"
    ],
    "client": [
      "com.subtitlescreen.SubtitleScreenModClient"
    ]
  },
  "mixins": [
    "subtitlescreen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api-base": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-networking-api-v1": "*",
    "fabric-object-builder-api-v1": "*",
    "fabric-creative-tab-api-v1": "*",
    "fabric-rendering-v1": "*"
  }
}
